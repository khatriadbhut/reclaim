# Reclaim — environment template
#
# The API server loads variables from: backend/.env
# From repo root:
#   cp .env.example backend/.env
#
# Never commit backend/.env or any file containing real secrets.

# --- Required for core product (extension + user dashboard + AI) ---
GEMINI_API_KEY=

# Chrome extension OAuth client ID (must match extension/manifest.json oauth2.client_id).
# Required: server validates access tokens against this audience via Google tokeninfo.
RECLAIM_EXT_OAUTH_CLIENT_ID=

# API port (default 3000). Must match extension and dashboard BACKEND URL.
PORT=3000

# Signs bearer tokens for user APIs (extension sync, classify, etc.). Min 32 chars.
# Required when SECURITY_STRICT=1 or NODE_ENV=production.
# USER_API_SECRET=

# Optional: set to 1 to force strict CORS + strong secret checks in non-production.
# SECURITY_STRICT=0

# Production: comma-separated HTTPS origins for the hosted dashboard (strict CORS).
# ALLOWED_PUBLIC_ORIGINS=https://your-dashboard.example

# Behind AWS ALB / reverse proxy: set so rate limits see the real client IP.
# TRUST_PROXY=1

# Signs pseudonymous ids in B2B exports (min 32 chars). Required for company flows.
# EXPORT_ID_SECRET=

# --- B2B export governance (optional) ---
# Production default is 100 when unset (see export/governance.js). For local dev set 0:
# RECLAIM_MIN_EXPORT_ROWS=0
# Dirichlet-style prior strength for category_distribution_pct in cross-platform package (0 = off).
# RECLAIM_DISTRIBUTION_SHRINK=0
# Include data_label blob on JSON exports (off unless 1).
# RECLAIM_EXPORT_DATA_LABEL=0
# Filled into data_label JSON when enabled.
# RECLAIM_PROVIDER_DOMAIN=
# RECLAIM_PROVIDER_CONTACT=

# --- Durable panel store (optional; strongly recommended before Chrome Web Store) ---
# DATABASE_URL=postgres://user:pass@localhost:5432/reclaim
# PG_POOL_MAX=10
# Periodic full-panel IAB re-enrich + Postgres persist (0/1).
# ENABLE_BATCH_ENRICH=0
# BATCH_ENRICH_INTERVAL_MS=21600000

# --- Domain categorization (optional) ---
# Enables WhoisXML website category lookup + quota tracking + IAB enrichment.
WHOISXML_API_KEY=
# Free-tier limit used for quota reporting (default: 100).
WHOISXML_FREE_LIMIT=100
# Minimum confidence required to persist strict domain mappings (default: 0.9).
WHOISXML_MIN_CONFIDENCE=0.9
# If set to 1, allow Gemini to be used as a tie-breaker for unknown domains (default: 0).
ALLOW_GEMINI_DOMAIN_LOOKUP=0

# --- Company dashboard (Reclaim Business) — optional for extension-only dev ---
# Create a separate "Web application" OAuth client in Google Cloud (not the Chrome extension client).
COMPANY_GOOGLE_CLIENT_ID=
COMPANY_GOOGLE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI on that OAuth client.
COMPANY_OAUTH_REDIRECT_URL=http://localhost:3000/api/company/auth/google/callback
# Long random string used to sign session cookies (generate e.g. openssl rand -hex 32).
COMPANY_COOKIE_SECRET=
# Origin of the Vite dashboard (no trailing slash). Must match CORS/credentials for company APIs.
COMPANY_DASHBOARD_ORIGIN=http://localhost:5173

# Optional
# NODE_ENV=production
